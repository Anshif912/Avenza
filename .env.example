# ==============================================================================
# AVENZA — Environment Configuration Template
# Copy this file to .env.local for local environment overrides
# ==============================================================================

# Application Port (Vite Dev Server)
VITE_PORT=3000

# ESP32 REST API Target for Vite Proxy (/api/esp32 -> target)
# In development without physical hardware, points to the mock server:
VITE_ESP32_TARGET=http://localhost:8080
# When connected to your physical ESP32 on your Wi-Fi, change to its IP:
# VITE_ESP32_TARGET=http://192.168.1.150

# Optional Direct ESP32 Base URL (used if bypassing the Vite proxy):
# VITE_ESP32_BASE_URL=http://192.168.1.150

# Optional ESP32 WebSocket / WebSerial fallback
VITE_WS_URL=ws://192.168.1.120:8080

